\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {FedMKS overview.} Clients are grouped into three architecture tiers (Small, Medium, Large). Two cooperation layers operate each round: \textbf  {Layer 1} (intra-tier) shares \emph  {model weights} --- clients in a tier FedAvg their weights into a tier model $W_t$; \textbf  {Layer 2} (cross-tier) shares \emph  {knowledge} --- every client uploads a feature carrier $s_k$ to the server, which returns the global carrier $\bar  s$ used as a distillation target. Steps: \textcircled {1}~local training (CE on private data $+$ KD on the public set), \textcircled {2}\textcircled {3}~compute the local carrier, \textcircled {4}~upload carrier $+$ weights, \textcircled {5}~server aggregates carriers globally and weights per tier.}}{4}{}\protected@file@percent }
\newlabel{fig:fedmksoverview}{{2}{4}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {FedMKS round timeline.} From round $r{=}2$ onward, every client receives the global carrier $\bar  {s}$ and its tier's averaged classifier weights $\mathbf  {W}_{t_k}$ from the server; runs $E_{\text  {kd}}$ KD epochs on the public set using $\bar  {s}$ as targets; runs $E_{\text  {loc}}$ local epochs on private data; then returns its updated carrier $s_k$ and classifier weights $w_k$ to the server. Round $r{=}1$ bootstraps by local training only, producing the first carriers and weights.}}{4}{}\protected@file@percent }
\newlabel{fig:fedmkstimeline}{{3}{4}{}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Algorithm summary ($\text  {$\mathsurround \z@ \mathchar "458$}$ = feature used; $\dagger $~Phase~3 only).}}{4}{}\protected@file@percent }
