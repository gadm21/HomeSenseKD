\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Validation accuracy over 50 federated rounds under IID partitioning (mean across completed seeds). Panels (left-to-right): HomeOccupancy, MNIST, CIFAR-10. All algorithms use uniform tier distribution (35\%~S/35\%~M/30\%~L); FedAvg/FedProx are restricted to the all-small architecture. On HomeOccupancy, FedAvg and FedMKS match the centralised ceiling while soft-label-only methods lag slightly. On MNIST all FL methods approach centralised accuracy; on CIFAR-10 the cross-domain public pool suppresses all federated methods ${>}10\%$ below Central. \dag  ~HomeOccupancy FedMD/FedAKD/FedMKS are single-seed; remaining seeds are in progress.}}{5}{}\protected@file@percent }
\newlabel{fig:phase1iid}{{2}{5}{}{figure.2}{}}
\newlabel{legendPnoniid}{{\expandafter\protect\csname pgfplots@legend@to@name@legendPnoniid\endcsname}{5}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Validation accuracy over 50 federated rounds under non-IID partitioning (Dirichlet $\alpha {=}0.5$; mean across completed seeds). Panels (left-to-right): MNIST, CIFAR-10. The HomeOccupancy non-IID condition is omitted while its runs complete. On MNIST, FedMKS/FedAvg/FedProx stay near-centralised while soft-label-only methods plateau at ${\approx }84\%$. On CIFAR-10, FedAvg edges out FedProx and FedMKS.}}{5}{}\protected@file@percent }
\newlabel{fig:phase1noniid}{{3}{5}{}{figure.3}{}}
