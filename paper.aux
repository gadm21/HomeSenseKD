\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {FedMKS --- one communication round.} Each client trains on its private data, computes soft labels $s_k$ on the shared public set, and uploads $s_k$ together with its model weights $w_k$. The server only averages tensors: a global soft-label average $\bar  s$ and per-tier weight averages ($W_S,W_M,W_L$), which are then returned to the clients.}}{2}{}\protected@file@percent }
\newlabel{fig:fedmksoverview}{{1}{2}{}{figure.1}{}}
