\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Phase 2: FedMD tier-heterogeneity ablation on HomeOccupancy.} Validation accuracy over 50 rounds under three tier distributions---\texttt  {all\_small} (100\%~S), \texttt  {uniform} (35/35/30), \texttt  {skewed} (60/30/10)---for IID (left) and non-IID (right) partitions. Tier composition has negligible effect under IID (86.1--86.8\%); under non-IID, \texttt  {uniform} modestly leads (61.5\% vs.\ 59.1\%/58.6\%).}}{7}{}\protected@file@percent }
\newlabel{fig:phase2}{{6}{7}{}{figure.6}{}}
