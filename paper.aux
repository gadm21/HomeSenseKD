\bibcite{ma2019survey}{1}
\newlabel{legendPtwo}{{\expandafter\protect\csname pgfplots@legend@to@name@legendPtwo\endcsname}{6}{}{paragraph.5.2.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces FedMD tier-heterogeneity ablation on HomeOccupancy. Validation accuracy over 50 rounds under three tier distributions---\texttt  {all\_small} (100\%~S), \texttt  {uniform} (35/35/30), \texttt  {skewed} (60/30/10)---for IID (left) and non-IID (right) partitions. Tier composition has negligible effect under IID; under non-IID the small-dominated distributions (\texttt  {all\_small}, \texttt  {skewed}) converge below the balanced \texttt  {uniform} mix.}}{6}{}\protected@file@percent }
\newlabel{fig:phase2}{{4}{6}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Phase~3: mean client validation accuracy of FedMKS and FedDF on HomeOccupancy under IID (single seed, 30 rounds, 10 clients). FedDF plateaus earlier (round~${\approx }10$) near 89\%; FedMKS climbs more gradually, reaching ${\approx }88\%$ by round~30.}}{6}{}\protected@file@percent }
\newlabel{fig:phase3}{{5}{6}{}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Phase~3 efficiency comparison on HomeOccupancy (IID, 30 rounds, 10 clients). Accuracy is the mean over the final five rounds, as in Phase~1. FedMKS removes the server-side distillation bottleneck by distributing it across parallel clients, at higher per-client compute and modestly more communication.}}{6}{}\protected@file@percent }
\newlabel{tab:efficiency}{{IV}{6}{}{table.4}{}}
