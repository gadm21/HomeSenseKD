\newlabel{legendPiid}{{\expandafter\protect\csname pgfplots@legend@to@name@legendPiid\endcsname}{6}{}{subsubsection.5.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Phase 1: Validation accuracy over 50 federated rounds under IID partitioning} (mean across completed seeds). All algorithms use uniform tier distribution (35\%~S/35\%~M/30\%~L). On HomeOccupancy, FedAvg and FedMKS match the centralised ceiling while soft-label-only methods lag slightly. HomeHAR collapses to the majority-class baseline (${\approx }31\%$) for every method including Central---a dataset-level limitation. On MNIST all FL methods approach centralised accuracy; on CIFAR-10 the cross-domain public pool suppresses all federated methods ${>}10\%$ below Central. \dag  ~HomeOccupancy FedMD/FedAKD/FedMKS are single-seed; remaining seeds are in progress.}}{6}{}\protected@file@percent }
\newlabel{fig:phase1iid}{{4}{6}{}{figure.4}{}}
\newlabel{legendPnoniid}{{\expandafter\protect\csname pgfplots@legend@to@name@legendPnoniid\endcsname}{6}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Phase 1: Validation accuracy over 50 federated rounds under non-IID partitioning} (Dirichlet $\alpha {=}0.5$; mean across completed seeds). The HomeOccupancy non-IID condition is omitted while its runs complete. On HomeHAR every federated method falls \emph  {below} the ${\approx }31\%$ majority baseline while Central remains at it. On MNIST, FedMKS/FedAvg/FedProx stay near-centralised while soft-label-only methods plateau at ${\approx }85\%$. On CIFAR-10, FedAvg edges out FedProx and FedMKS.}}{6}{}\protected@file@percent }
\newlabel{fig:phase1noniid}{{5}{6}{}{figure.5}{}}
