\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces FedMD tier-heterogeneity ablation on HomeOccupancy. Top: mean validation-accuracy curves over completed seeds (shaded bands: seed range), IID (left) and non-IID (right) on a shared y-axis. Bottom: per-client final accuracy (mean of the last five rounds, seeds pooled). Each distribution column is subdivided by architecture tier---small (orange), medium (teal), large (purple)---so tier counts are visible (e.g.\ \texttt  {skewed}: 12/6/2); short coloured dashes mark tier means, the long black dash the column mean. Tier means differ by only a few points within every setting: under soft-label sharing, per-client accuracy is governed by the data partition, not by model capacity.}}{8}{}\protected@file@percent }
\newlabel{fig:tierablation}{{8}{8}{}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces FedMKS vs.\ FedDF validation accuracy on HomeOccupancy (IID, 30 rounds, 10 clients). The dashed curve is a FedMKS ablation with Mixup augmentation on the public set disabled.}}{8}{}\protected@file@percent }
\newlabel{fig:feddf}{{9}{8}{}{figure.9}{}}
